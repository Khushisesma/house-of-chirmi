{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.houseofchirmi.in" }],
      "destination": "https://www.houseofchirmi.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "houseofchirmi.in" }],
      "destination": "https://www.houseofchirmi.com/:path*",
      "permanent": true
    }
  ]
}
